# Dependencies and build output (recreate with `make install` / `make demo`)
node_modules/
.venv/
dist/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS and editor files
.DS_Store
.idea/
.vscode/

# Local environment and credentials: never commit these
.env
.env.*
!.env.example
*.pem

# Model weights and checkpoints belong in S3, not git
*.safetensors
*.gguf
*.pt
*.ckpt

# Claude Code agent worktrees (temporary copies of this repo)
.claude/worktrees/

# Evidence ledger signing secret (dashboard/backend/.evidence-key): never commit
.evidence-key

# Organiser hackathon docs (confidential, no redistribution): never commit
hackathon_docs/

# Team kit secrets and host files: never commit (the pre-push guard in scripts/hooks also blocks them).
# .env, .env.*, *.pem and .evidence-key are already covered above.
tokens/
kit.json
kit-state.json
a2a_token*
builder_admin_password*
**/host.env
