// team13_ran_screen_nlm_answers  validationMode=IGNORE_ALL_FINDINGS
// generated by t3/policies/generate.py
suppressOutput (principal, action == AgentCore::Action::"nlm13___ask", resource == @GW@)
when guardrails {
  BedrockGuardrails::ContentFilter(["VIOLENCE", "HATE", "MISCONDUCT"], ["$.content[*].text", "$.result.content[*].text"])["VIOLENCE"].confidenceScore.greaterThan(decimal("0.2"))
  || BedrockGuardrails::ContentFilter(["VIOLENCE", "HATE", "MISCONDUCT"], ["$.content[*].text", "$.result.content[*].text"])["HATE"].confidenceScore.greaterThan(decimal("0.2"))
  || BedrockGuardrails::ContentFilter(["VIOLENCE", "HATE", "MISCONDUCT"], ["$.content[*].text", "$.result.content[*].text"])["MISCONDUCT"].confidenceScore.greaterThan(decimal("0.2"))
};
