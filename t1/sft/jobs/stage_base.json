{
  "job": {
    "name": "t1.sft.stage_base",
    "what": "Stage the event base model: the copied fp32 .bin shards to bf16 safetensors, sha256 of every file, model record",
    "entry": ["python", "-m", "t1.sft.stage_base"],
    "args": ["--run-id", "{{run_id}}",
             "--src", "s3://{{bucket}}/models/base/otel-llm-1.7b-it/",
             "--dst", "s3://{{bucket}}/models/base/otel-llm-1.7b-it-bf16/{{run_id}}/",
             "--evidence", "s3://{{bucket}}/evidence/",
             "--code-sha", "{{code_sha}}",
             "--write-result"],
    "job_kind": "training",
    "instance_type": "ml.m5.2xlarge",
    "instance_count": 1,
    "volume_size_gb": 60,
    "max_run_s": 5400,
    "spot": false,
    "image": "763104351884.dkr.ecr.us-east-2.amazonaws.com/pytorch-training:2.8.0-cpu-py312",
    "requirements": "t1/sft/requirements-stage.txt",
    "code_paths": ["t1/", "contracts/", "tools/", "twin/"],
    "env": {"EVIDENCE_S3": "s3://{{bucket}}/evidence/", "CODE_SHA": "{{code_sha}}", "HF_HUB_OFFLINE": "1",
            "TRANSFORMERS_OFFLINE": "1"},
    "region": "us-east-2",
    "role": "bb26-SageMakerExecution (existing; never created by this job)",
    "reads": ["s3://{{bucket}}/models/base/otel-llm-1.7b-it/ (14 objects, 6.9 GB; t1/sft/staging/base_copy.json)"],
    "writes": ["s3://{{bucket}}/models/base/otel-llm-1.7b-it-bf16/{{run_id}}/ (model.safetensors, tokenizer and config byte copies, SHA256SUMS, stage_summary.json)",
               "s3://{{bucket}}/evidence/models/otel-llm-1.7b-it/{{run_id}}.json (model record)",
               "s3://{{bucket}}/evidence/results/{{run_id}}.json (result record)"],
    "expected": {"wall_min": "15-30 (download 6.9 GB, hash, convert, verify 311 tensors, CPU smoke decode)", "peak_ram_gib": 15}
  },
  "declared": {
    "schema_version": "1",
    "kind": "declared",
    "team": "team13",
    "run_id": "{{run_id}}",
    "synthetic": false,
    "unit": "t1.sft.stage",
    "track": "track-1",
    "target": {"metric": "tensor_mismatch_count", "op": "==", "value": 0, "unit": "count"},
    "n_items": 311,
    "test_set_sha256": "25df4377f824767f051e557974776e3e75dec012b4f263b497ecde00e7cf402d",
    "model_id": "otel-llm-1.7b-it",
    "grader": "t1/sft/stage_base.py:verify (each of the 311 tensors named by the source index equals its bf16 cast in the safetensors output; lm_head must equal embed_tokens in the source to be stored tied; no extra tensors; all bf16)",
    "code_sha": "{{code_sha}}",
    "region": "us-east-2",
    "decoding": {
      "test_set_is": "sha256 of pytorch_model.bin.index.json in the copied base prefix: the list of the 311 tensors that are verified",
      "source": {"hf_repo": "farbodtavakkoli/OTel-LLM-1.7B-IT", "revision": "2a2d417b4c84d7ea609d6026a864cdf666ab1491",
                 "copy_record": "t1/sft/staging/base_copy.json",
                 "shard_etags": {"pytorch_model-00001-of-00002.bin": "315220401cc11e8e76e5d450e8537435-593",
                                 "pytorch_model-00002-of-00002.bin": "5d1865e8c2a0576c0b4b974dda711232-229"}},
      "job": {"instance_type": "ml.m5.2xlarge", "image": "pytorch-training:2.8.0-cpu-py312", "transformers": "4.57.6",
              "output_dtype": "bfloat16", "smoke": "chat template with enable_thinking=False must end with the empty think block; greedy decode 8 tokens"}
    }
  }
}
